<Window
    x:Class="Automation.Desktop.ObsConnectionWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Connexion OBS — CuezyBot"
    Width="650"
    Height="570"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="#0D1125">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="Foreground" Value="#F4F3FF" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#9AA1BD" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#8A36F5" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <Grid Margin="28" RowDefinitions="Auto,*,Auto">
    <StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="48" Height="48" CornerRadius="24" Background="#171B34" BorderBrush="#EEEEF7" BorderThickness="1">
          <TextBlock Text="OBS" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Connecter OBS" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="OBS WebSocket 5.x" Classes="muted" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="Ces informations restent dans CuezyBot. Le mot de passe ne sera jamais placé dans une automatisation." TextWrapping="Wrap" Classes="muted" Margin="0,8,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="15">
      <StackPanel Spacing="6">
        <TextBlock Text="Adresse du serveur" FontWeight="SemiBold" />
        <TextBox x:Name="ServerHost" Text="127.0.0.1" />
        <TextBlock Text="Utilise 127.0.0.1 lorsque OBS fonctionne sur ce même ordinateur." Classes="muted" FontSize="12" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Port" FontWeight="SemiBold" />
        <TextBox x:Name="ServerPort" Text="4499" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Mot de passe OBS" FontWeight="SemiBold" />
        <TextBox x:Name="ServerPassword" PasswordChar="●" />
      </StackPanel>

      <Border Padding="13" CornerRadius="9" Background="#151A31" BorderBrush="#2C3353" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*">
          <Border x:Name="StatusDot" Width="10" Height="10" CornerRadius="5" Background="#7C849F" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock x:Name="ConnectionStatus" Text="Connexion non testée" FontWeight="SemiBold" />
            <TextBlock x:Name="ConnectionDetail" Text="Clique sur Tester la connexion." Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
      <Button Grid.Column="1" Content="Fermer" Click="OnCloseClick" />
      <Button x:Name="TestSceneButton" Grid.Column="2" Content="Tester la scène Merci" Click="OnTestSceneClick" IsEnabled="False" />
      <Button x:Name="TestConnectionButton" Grid.Column="3" Classes="primary" Content="Tester la connexion" Click="OnTestConnectionClick" />
    </Grid>
  </Grid>
</Window>
