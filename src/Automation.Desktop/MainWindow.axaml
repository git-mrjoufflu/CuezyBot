<Window
    x:Class="Automation.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CuezyBot"
    Width="1500"
    Height="900"
    MinWidth="1180"
    MinHeight="720"
    Background="#070A18">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="Foreground" Value="#F4F3FF" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#9299B6" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#8A36F5" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.surface">
      <Setter Property="Background" Value="#171B34" />
      <Setter Property="Foreground" Value="#E8E7F5" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#CDD0E3" />
      <Setter Property="Padding" Value="13,10" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#392868" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.node">
      <Setter Property="Background" Value="#151A32" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.libraryItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="9,8" />
    </Style>
    <Style Selector="Border.libraryItem:pointerover">
      <Setter Property="Background" Value="#202744" />
    </Style>
    <Style Selector="Button.sectionHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="7,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.sectionHeader:pointerover">
      <Setter Property="Background" Value="#1D2340" />
    </Style>
    <Style Selector="Border.profileSettings">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Border.profileSettings:pointerover">
      <Setter Property="Background" Value="#29234A" />
      <Setter Property="BorderBrush" Value="#604B91" />
    </Style>
    <Style Selector="Border.productSection">
      <Setter Property="Background" Value="#10162B" />
      <Setter Property="BorderBrush" Value="#2B3556" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="58,*,46" ColumnDefinitions="200,*,0">
    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#0B0F22" BorderBrush="#292D49" BorderThickness="0,0,0,1">
      <Grid Margin="18,0" ColumnDefinitions="200,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="11">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#42BFFF" Offset="0" />
                <GradientStop Color="#9B35FF" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="◉" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
            <Run Text="Cuezy" /><Run Text="Bot" Foreground="#B14AFF" />
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ComboBox x:Name="WorkflowSelector" Width="210" SelectedIndex="0" SelectionChanged="OnWorkflowSelected">
          </ComboBox>
          <Button Classes="surface" Content="＋" ToolTip.Tip="Nouvelle automatisation" Click="OnNewWorkflowClick" Padding="8,5" />
          <Button Classes="surface" Content="✎" ToolTip.Tip="Renommer" Click="OnRenameWorkflowClick" Padding="8,5" />
          <Button Classes="surface" Content="🗑" ToolTip.Tip="Supprimer" Click="OnDeleteWorkflowClick" Padding="8,5" />
          <ComboBox x:Name="WorkflowTriggerSelector" Width="180" IsVisible="False" SelectionChanged="OnTriggerKindChanged" />
        </StackPanel>

        <Border Grid.Column="2" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#0D1125" BorderBrush="#292D49" BorderThickness="0,0,1,0" Padding="12,16">
      <Grid RowDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <Button Classes="nav" Content="⌂   Accueil" />
          <Button Classes="nav active" Content="⌘   Workflows" />
          <Button Classes="nav" Content="⚡   Événements" Click="OnHistoryClick" />
          <Button Classes="nav" Content="◇   Actions" />
          <Button Classes="nav" Content="𝑥   Variables" />
          <Button Classes="nav" Content="▣   Pages" />
        </StackPanel>

        <Border x:Name="CreatorCard" Grid.Row="1" Padding="13" CornerRadius="12" BorderBrush="#39466F" BorderThickness="1" IsVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#1A2040" Offset="0" />
              <GradientStop Color="#12172D" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#9A4DFF" Offset="0" />
                    <GradientStop Color="#4E2B9C" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Grid>
                  <TextBlock x:Name="CreatorAvatar" Text="C" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                  <Image x:Name="CreatorImage" IsVisible="False" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock x:Name="CreatorTitle" Text="Créateur" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="CreatorSubtitle" Text="Espace local  ·  Privé" Classes="muted" FontSize="10" />
              </StackPanel>
              <Border Grid.Column="2" Classes="profileSettings" PointerPressed="OnSettingsPointerPressed" ToolTip.Tip="Paramètres">
                <TextBlock Text="⚙" Foreground="#C9B4FF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" Background="#080C1B" ClipToBounds="True">
      <Canvas x:Name="WorkflowCanvas">
        <Canvas.Background>
          <DrawingBrush TileMode="Tile" DestinationRect="0,0,32,32" SourceRect="0,0,32,32">
            <DrawingBrush.Drawing>
              <GeometryDrawing Brush="#080C1B">
                <GeometryDrawing.Pen>
                  <Pen Brush="#151B31" Thickness="1" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                  <RectangleGeometry Rect="0,0,32,32" />
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Canvas.Background>

        <Border x:Name="WorkflowToolbar" Canvas.Right="18" Canvas.Top="18" Background="#11162B" BorderBrush="#2C3353" BorderThickness="1" CornerRadius="10" Padding="6,5">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock x:Name="TestStatus" Text="Brouillon enregistré" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="3,0,4,0" MaxWidth="300" TextWrapping="Wrap" />
            <Button x:Name="AddCanvasItemButton" Classes="primary" Content="＋  Action" Click="OnAddCanvasItemClick" Padding="9,7" ToolTip.Tip="Ajouter une action au canevas" />
            <Button x:Name="AddCanvasEventButton" Classes="surface" Content="＋  Événement" Click="OnAddCanvasEventClick" Padding="9,7" ToolTip.Tip="Ajouter un événement au canevas" />
            <Button Classes="surface" Content="▷  Tester" Click="OnTestClick" Padding="9,7" />
            <Button x:Name="RunOnceButton" Classes="surface" Content="Exécuter" Click="OnRunOnceClick" Padding="9,7" ToolTip.Tip="Exécuter la version publiée avec des effets réels" />
            <Button x:Name="UndoButton" Classes="surface" Content="↶" ToolTip.Tip="Annuler" Click="OnUndoClick" Padding="8,7" IsEnabled="False" />
            <Button x:Name="RedoButton" Classes="surface" Content="↷" ToolTip.Tip="Rétablir" Click="OnRedoClick" Padding="8,7" IsEnabled="False" />
            <Button x:Name="SaveWorkflowButton" Classes="surface" Content="Enregistrer" Click="OnSaveWorkflowClick" Padding="9,7" />
            <Button x:Name="StartWorkflowButton" Classes="primary" Content="▶  Démarrer" Click="OnStartWorkflowClick" Padding="9,7" />
          </StackPanel>
        </Border>

        <!-- Prototype demo links removed: links are created manually by the user. -->

        <Border x:Name="EventNode" Canvas.Left="75" Canvas.Top="175" Width="210" Height="100" Classes="node" BorderBrush="#9B42FF">
          <Grid RowDefinitions="32,*">
            <Border Background="#4A206F" CornerRadius="9,9,0,0" Padding="10,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="⚡  Événement" Foreground="#DFA8FF" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="12" VerticalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="8" Background="#6F35BE">
                <TextBlock Text="T" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
              </Border>
              <TextBlock Text="Nouveau follow" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="ConditionNode" Canvas.Left="360" Canvas.Top="225" Width="210" Height="105" Classes="node" BorderBrush="#3788F5">
          <Grid RowDefinitions="32,*">
            <Border Background="#173C73" CornerRadius="9,9,0,0" Padding="10,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="⌁  Condition" Foreground="#7EB8FF" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="12" VerticalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="8" Background="#275AA0">
                <TextBlock Text="♛" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Est un abonné ?" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </Grid>
        </Border>

        <Border IsVisible="False" Canvas.Left="605" Canvas.Top="183" Padding="17,6" CornerRadius="14" Background="#197246" BorderBrush="#45DD8D" BorderThickness="1">
          <TextBlock Text="Oui" FontWeight="SemiBold" />
        </Border>
        <Border IsVisible="False" Canvas.Left="600" Canvas.Top="345" Padding="17,6" CornerRadius="14" Background="#8C202E" BorderBrush="#FF5368" BorderThickness="1">
          <TextBlock Text="Non" FontWeight="SemiBold" />
        </Border>

        <Border x:Name="ObsAlertNode" Canvas.Left="670" Canvas.Top="115" Width="225" Height="110" Classes="node" BorderBrush="#35D57B">
          <Grid RowDefinitions="32,*">
            <Border Background="#145D38" CornerRadius="9,9,0,0" Padding="10,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="◆  Action" Foreground="#72F0AA" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="12" VerticalAlignment="Center">
              <Border Width="40" Height="40" CornerRadius="20" BorderBrush="#FFFFFF" BorderThickness="1">
                <TextBlock Text="OBS" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
              </Border>
              <TextBlock Text="Afficher une alerte&#10;OBS" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Canvas.Left="670" Canvas.Top="300" Width="225" Height="110" Classes="node" BorderBrush="#9C42FA">
          <Grid RowDefinitions="32,*">
            <Border Background="#48206F" CornerRadius="9,9,0,0" Padding="10,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="◆  Action" Foreground="#D39AFF" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="12" VerticalAlignment="Center">
              <Border Width="40" Height="40" CornerRadius="9" Background="#6840A7">
                <TextBlock Text="D" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
              </Border>
              <TextBlock Text="Envoyer un message&#10;Discord" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Canvas.Left="575" Canvas.Top="400" Width="210" Height="92" Classes="node" BorderBrush="#9C42FA">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="12" VerticalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="9" Background="#693CB0">
              <TextBlock Text="♫" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Action" Foreground="#C98AFF" FontSize="11" />
              <TextBlock Text="Jouer un son" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Canvas.Left="865" Canvas.Top="400" Width="220" Height="92" Classes="node" BorderBrush="#9C42FA">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="12" VerticalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="9" Background="#693CB0">
              <TextBlock Text="＋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Action" Foreground="#C98AFF" FontSize="11" />
              <TextBlock Text="Ajouter au compteur" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border IsVisible="False" Canvas.Left="30" Canvas.Bottom="22" Width="590" Height="132" Background="#0E1328" BorderBrush="#303653" BorderThickness="1" CornerRadius="13" Padding="16">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="▣  Bibliothèque de modèles" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="Voir tout  ›" Foreground="#B66AFF" FontSize="12" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
              <Border Grid.Column="0" Background="#171C35" CornerRadius="9" Padding="10">
                <StackPanel HorizontalAlignment="Center" Spacing="5"><TextBlock Text="♥" Foreground="#C34EFF" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Follow avec alerte" FontSize="11" /></StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#171C35" CornerRadius="9" Padding="10">
                <StackPanel HorizontalAlignment="Center" Spacing="5"><TextBlock Text="★" Foreground="#4199FF" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Nouvel abonné" FontSize="11" /></StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#171C35" CornerRadius="9" Padding="10">
                <StackPanel HorizontalAlignment="Center" Spacing="5"><TextBlock Text="♛" Foreground="#4AE3A0" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Raid + message" FontSize="11" /></StackPanel>
              </Border>
              <Border Grid.Column="3" Background="#171C35" CornerRadius="9" Padding="10">
                <StackPanel HorizontalAlignment="Center" Spacing="5"><TextBlock Text="◆" Foreground="#FFAE55" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Cheer + son" FontSize="11" /></StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <StackPanel x:Name="CanvasControls" Canvas.Right="18" Canvas.Bottom="20" Orientation="Horizontal" Spacing="7">
          <Button Classes="surface" Content="−" Click="OnZoomOutClick" />
          <Border Background="#171B34" CornerRadius="7" Padding="12,9"><TextBlock x:Name="CanvasZoomLabel" Text="100 %" Classes="muted" /></Border>
          <Button Classes="surface" Content="＋" Click="OnZoomInClick" />
          <Button Classes="surface" Content="Centrer" Click="OnCenterCanvasClick" />
        </StackPanel>
      </Canvas>
    </Grid>

    <Border Grid.Row="1" Grid.Column="2" IsVisible="False" Background="#0C1022" BorderBrush="#292D49" BorderThickness="1,0,0,0" Padding="14">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBox x:Name="ActionSearch" Height="38" CornerRadius="9" PlaceholderText="Rechercher une action…" TextChanged="OnActionSearchChanged" />
        <Border Grid.Row="1" Height="1" Background="Transparent" Margin="0,10,0,0" />
        <Grid Grid.Row="2" Margin="0,10,0,12" ColumnDefinitions="*,*" Background="#11162B">
          <Border x:Name="ActionsTab" Grid.Column="0" Padding="8" Background="#4A2A7D" CornerRadius="8" PointerPressed="OnActionsTabPressed"><TextBlock Text="Actions" HorizontalAlignment="Center" FontWeight="SemiBold" /></Border>
          <Border x:Name="EventsTab" Grid.Column="1" Padding="8" CornerRadius="8" PointerPressed="OnEventsTabPressed"><TextBlock Text="Événements" HorizontalAlignment="Center" Classes="muted" /></Border>
        </Grid>
        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" PointerPressed="OnLibraryActionPressed">
          <StackPanel Spacing="10" HorizontalAlignment="Stretch">
            <Border x:Name="EventLibrarySection" Classes="productSection" IsVisible="False">
              <StackPanel Spacing="6">
                <Button Classes="sectionHeader">
                  <Grid ColumnDefinitions="Auto,*,Auto"><Border Width="28" Height="28" CornerRadius="8" Background="#6A2FA5"><TextBlock Text="⚡" Foreground="#E6C8FF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Margin="9,0,0,0" Text="Déclencheurs" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="⌃" Foreground="#C9CEE1" FontSize="16" VerticalAlignment="Center" /></Grid>
                </Button>
                <Border Classes="libraryItem eventItem" Tag="manual.run"><TextBlock Text="▶  Exécution manuelle" /></Border>
                <Border Classes="libraryItem eventItem" Tag="twitch.follow.received"><TextBlock Text="♥  Nouveau follower Twitch" /></Border>
              </StackPanel>
            </Border>
            <Border x:Name="TwitchActionSection" Classes="productSection" IsVisible="False">
              <StackPanel Spacing="6">
              <Button Classes="sectionHeader" Click="OnTwitchSectionClick">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="28" Height="28" CornerRadius="8" Background="#9146FF"><TextBlock Text="T" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="Twitch" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock x:Name="TwitchSectionChevron" Grid.Column="2" Text="⌃" Foreground="#C9CEE1" FontSize="16" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <StackPanel x:Name="TwitchActions" Spacing="6">
                <Border Classes="libraryItem"><TextBlock Text="▣  Envoyer un message" /></Border>
                <Border Classes="libraryItem"><TextBlock Text="▣  Créer un clip" /></Border>
                <Border Classes="libraryItem"><TextBlock Text="✎  Modifier un titre" /></Border>
                <Border Classes="libraryItem"><TextBlock Text="◎  Gérer les points de chaîne" /></Border>
                <Border Classes="libraryItem"><TextBlock Text="♟  Récupérer un utilisateur" /></Border>
              </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="ObsActionSection" Classes="productSection" IsVisible="False">
              <StackPanel Spacing="6">
              <Button Classes="sectionHeader" Click="OnObsSectionClick">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="28" Height="28" CornerRadius="14" Background="#343A4D"><TextBlock Text="OBS" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="OBS Studio" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock x:Name="ObsSectionChevron" Grid.Column="2" Text="⌃" Foreground="#C9CEE1" FontSize="16" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <StackPanel x:Name="ObsActions" Spacing="6">
                <Border Classes="libraryItem"><TextBlock Text="◉  Changer de scène" /></Border>
                <Border Classes="libraryItem"><TextBlock Text="▻  Visibilité d’une source" /></Border>
                <Border Classes="libraryItem"><TextBlock Text="●  Démarrer un replay" /></Border>
                <Border Classes="libraryItem"><TextBlock Text="▧  Prendre une capture" /></Border>
              </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="productSection">
              <StackPanel Spacing="6">
              <Button Classes="sectionHeader" Click="OnCoreSectionClick">
                <Grid ColumnDefinitions="Auto,*,Auto"><Border Width="28" Height="28" CornerRadius="8" Background="#245A91"><TextBlock Text="◆" Foreground="#7DBEFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Margin="9,0,0,0" Text="CORE" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="CoreSectionChevron" Grid.Column="2" Text="⌃" Foreground="#C9CEE1" FontSize="16" VerticalAlignment="Center" /></Grid>
              </Button>
              <StackPanel x:Name="CoreActions" Spacing="6">
                <Border Classes="libraryItem"><TextBlock Text="◇  Ajouter une condition" /></Border>
                <Border Classes="libraryItem"><TextBlock Text="◷  Attendre" /></Border>
                <Border Classes="libraryItem"><TextBlock Text="＋  Modifier une variable" /></Border>
                <Border Classes="libraryItem"><TextBlock Text="♫  Jouer un son" /></Border>
              </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#0A0E20" BorderBrush="#292D49" BorderThickness="0,1,0,0">
      <Grid Margin="16,0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="22" Height="22" CornerRadius="11" ClipToBounds="True" Background="#52308B">
            <Grid><TextBlock x:Name="StatusCreatorAvatarFallback" Text="C" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="StatusCreatorImage" IsVisible="False" Stretch="UniformToFill" /></Grid>
          </Border>
          <StackPanel><TextBlock x:Name="StatusCreatorName" Text="Créateur" Foreground="#E8E7F5" FontSize="11" /><TextBlock Text="Moteur actif" Foreground="#5EE6A8" FontSize="9" /></StackPanel>
          <Border Classes="profileSettings" PointerPressed="OnSettingsPointerPressed" ToolTip.Tip="Paramètres">
            <TextBlock Text="⚙" Foreground="#C9B4FF" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>

        <Border Grid.Column="1" />

        <StackPanel x:Name="IntegrationStatusArea" Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <ToolTip.Tip>
            <Border Background="#171B34" BorderBrush="#3A4264" BorderThickness="1" CornerRadius="7" Padding="10,7">
              <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Ellipse x:Name="IntegrationObsTooltipDot" Width="8" Height="8" Fill="#F1B85B" VerticalAlignment="Center" />
                  <TextBlock Text="OBS" FontSize="11" />
                  <TextBlock x:Name="IntegrationObsTooltipStatus" Text="Non connecté" Foreground="#FFD081" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Ellipse x:Name="IntegrationTwitchTooltipDot" Width="8" Height="8" Fill="#F1B85B" VerticalAlignment="Center" />
                  <TextBlock Text="Twitch" FontSize="11" />
                  <TextBlock x:Name="IntegrationTwitchTooltipStatus" Text="Non connecté" Foreground="#FFD081" FontSize="11" />
                </StackPanel>
              </StackPanel>
            </Border>
          </ToolTip.Tip>
          <Border x:Name="IntegrationStatusDot" Width="8" Height="8" CornerRadius="4" Background="#7C849F" />
          <TextBlock x:Name="IntegrationCountStatus" Text="0/2 intégrations connectées" Classes="muted" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
