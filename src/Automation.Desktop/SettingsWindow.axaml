<Window x:Class="Automation.Desktop.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres" Width="650" Height="620" CanResize="False"
        Background="#0D1125">
  <StackPanel Margin="28" Spacing="18">
    <TextBlock Text="Paramètres" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="Personnalise le comportement de CuezyBot." Classes="muted" />
    <Border Background="#151A30" BorderBrush="#303858" BorderThickness="1" CornerRadius="10" Padding="16">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,220" RowSpacing="10">
        <StackPanel>
          <TextBlock Text="Langue / Language" FontWeight="SemiBold" />
          <TextBlock Text="Choisis la langue de l’interface." Classes="muted" FontSize="11" />
        </StackPanel>
        <ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectedIndex="0">
          <ComboBoxItem Content="Français" Tag="Français" />
          <ComboBoxItem Content="English" Tag="English" />
        </ComboBox>
      </Grid>
    </Border>
    <TextBlock Text="Intégrations" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <Border Grid.Column="0" Background="#151A30" BorderBrush="#303858" BorderThickness="1" CornerRadius="10" Padding="13">
        <StackPanel Spacing="9"><TextBlock Text="OBS Studio" FontWeight="SemiBold" /><TextBlock Text="Contrôle des scènes et sources." Classes="muted" FontSize="11" TextWrapping="Wrap" /><Button Classes="primary" Content="Configurer OBS" Click="OnObsClick" /></StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#151A30" BorderBrush="#6336A4" BorderThickness="1" CornerRadius="10" Padding="13">
        <StackPanel Spacing="9"><TextBlock Text="Twitch" FontWeight="SemiBold" /><TextBlock Text="OAuth et événements EventSub." Classes="muted" FontSize="11" TextWrapping="Wrap" /><Button Classes="primary" Content="Connecter Twitch" Click="OnTwitchClick" /></StackPanel>
      </Border>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Annuler" Click="OnCancelClick" />
      <Button Classes="primary" Content="Enregistrer" Click="OnSaveClick" />
    </StackPanel>
  </StackPanel>
</Window>
