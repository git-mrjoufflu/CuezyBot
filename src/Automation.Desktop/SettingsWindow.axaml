<Window x:Class="Automation.Desktop.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres" Width="650" Height="620" CanResize="False"
        Background="#0D1125">
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="Inter" /><Setter Property="Foreground" Value="#F4F3FF" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#9AA1BD" /></Style>
    <Style Selector="Button"><Setter Property="FontFamily" Value="Inter" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12,8" /><Setter Property="Background" Value="#171B34" /><Setter Property="Foreground" Value="#E8E7F5" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#8A36F5" /><Setter Property="Foreground" Value="#FFFFFF" /></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#292A50" /></Style>
    <Style Selector="Button.primary:pointerover"><Setter Property="Background" Value="#A44DFF" /></Style>
    <Style Selector="ComboBox"><Setter Property="FontFamily" Value="Inter" /><Setter Property="Background" Value="#171B34" /><Setter Property="Foreground" Value="#F4F3FF" /><Setter Property="BorderBrush" Value="#3A4264" /><Setter Property="BorderThickness" Value="1" /></Style>
  </Window.Styles>
  <ScrollViewer><StackPanel Margin="28" Spacing="18">
    <TextBlock x:Name="SettingsTitle" Text="Paramètres" FontSize="24" FontWeight="SemiBold" />
    <TextBlock x:Name="SettingsDescription" Text="Personnalise le comportement de CuezyBot." Classes="muted" />
    <Border Background="#151A30" BorderBrush="#303858" BorderThickness="1" CornerRadius="10" Padding="16">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,220" RowSpacing="10">
        <StackPanel>
          <TextBlock x:Name="LanguageTitle" Text="Langue / Language" FontWeight="SemiBold" />
          <TextBlock x:Name="LanguageDescription" Text="Choisis la langue de l’interface." Classes="muted" FontSize="11" />
        </StackPanel>
        <ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnLanguageChanged">
          <ComboBoxItem Content="Français" Tag="Français" />
          <ComboBoxItem Content="English" Tag="English" />
        </ComboBox>
      </Grid>
    </Border>
    <TextBlock x:Name="IntegrationsTitle" Text="Intégrations" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
    <StackPanel Spacing="12">
      <Border Background="#151A30" BorderBrush="#303858" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="9">
          <TextBlock Text="OBS Studio" FontWeight="SemiBold" FontSize="15" />
          <TextBlock x:Name="ObsStatus" Text="Non connecté" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          <CheckBox x:Name="ObsAutoReconnectCheck" Content="Reconnexion automatique" IsCheckedChanged="OnAutoReconnectChanged" />
          <TextBlock x:Name="ObsAutoReconnectDescription" Text="Réessaie toutes les 15 secondes après une coupure." Classes="muted" FontSize="11" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ObsButton" Classes="primary" Content="Reconnecter" Click="OnObsClick" />
            <Button x:Name="ObsConfigureButton" Content="Configurer" Click="OnObsConfigureClick" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Background="#151A30" BorderBrush="#6336A4" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="9">
          <TextBlock Text="Twitch" FontWeight="SemiBold" FontSize="15" />
          <TextBlock x:Name="TwitchStatus" Text="Non connecté" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          <CheckBox x:Name="TwitchAutoReconnectCheck" Content="Reconnexion automatique" IsCheckedChanged="OnAutoReconnectChanged" />
          <TextBlock x:Name="TwitchAutoReconnectDescription" Text="Réessaie toutes les 15 secondes après une coupure." Classes="muted" FontSize="11" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="TwitchButton" Classes="primary" Content="Reconnecter" Click="OnTwitchClick" />
            <Button x:Name="TwitchAuthorizeButton" Content="Renouveler l’autorisation" Click="OnTwitchAuthorizeClick" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    <Border Background="#151A30" BorderBrush="#303858" BorderThickness="1" CornerRadius="10" Padding="13">
      <StackPanel Spacing="9">
        <TextBlock x:Name="BackupsTitle" Text="Sauvegardes" FontWeight="SemiBold" />
        <TextBlock x:Name="BackupsDescription" Text="Sauvegarde les automatisations, réglages et historiques dans data/backups." Classes="muted" FontSize="11" TextWrapping="Wrap" />
        <Button x:Name="BackupButton" Content="Créer une sauvegarde" Click="OnBackupClick" />
        <TextBlock x:Name="BackupStatus" Classes="muted" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel></ScrollViewer>
</Window>
