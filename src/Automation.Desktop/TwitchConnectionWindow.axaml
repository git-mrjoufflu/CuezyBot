<Window
    x:Class="Automation.Desktop.TwitchConnectionWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Connexion Twitch — CuezyBot"
    Width="650"
    Height="590"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="#0D1125">
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="Inter" /><Setter Property="Foreground" Value="#F4F3FF" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#9AA1BD" /></Style>
    <Style Selector="Button"><Setter Property="FontFamily" Value="Inter" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="14,10" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#9147FF" /><Setter Property="Foreground" Value="White" /></Style>
  </Window.Styles>

  <Grid Margin="28" RowDefinitions="Auto,*,Auto">
    <StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="48" Height="48" CornerRadius="11" Background="#9147FF">
          <TextBlock Text="T" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Connecter Twitch" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="Connexion sécurisée dans le navigateur" Classes="muted" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="CuezyBot demandera uniquement la permission de lire les nouveaux followers pour ce prototype." TextWrapping="Wrap" Classes="muted" Margin="0,8,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="15">
      <Border Padding="16" CornerRadius="10" Background="#151A31" BorderBrush="#2C3353" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="Permission demandée" FontWeight="SemiBold" />
          <TextBlock Text="Lire la liste des followers de ta chaîne" />
          <TextBlock Text="moderator:read:followers" Classes="muted" FontSize="12" />
        </StackPanel>
      </Border>

      <Border Padding="18" CornerRadius="10" Background="#18132B" BorderBrush="#6532A6" BorderThickness="1">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <TextBlock Text="CODE TWITCH" Foreground="#B985FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
          <TextBlock x:Name="UserCode" Text="— — — — — — — —" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
          <TextBlock x:Name="VerificationAddress" Text="Le navigateur s’ouvrira automatiquement." Classes="muted" HorizontalAlignment="Center" />
          <Button x:Name="OpenBrowserButton" Content="Ouvrir Twitch" Click="OnOpenBrowserClick" IsEnabled="False" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <Border Padding="13" CornerRadius="9" Background="#151A31" BorderBrush="#2C3353" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*">
          <Border x:Name="StatusDot" Width="10" Height="10" CornerRadius="5" Background="#7C849F" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock x:Name="ConnectionStatus" Text="Twitch n’est pas connecté" FontWeight="SemiBold" />
            <TextBlock x:Name="ConnectionDetail" Text="Commence la connexion pour obtenir un code." Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <Button Grid.Column="1" Content="Fermer" Click="OnCloseClick" />
      <Button x:Name="ConnectButton" Grid.Column="2" Classes="primary" Content="Commencer la connexion" Click="OnConnectClick" />
    </Grid>
  </Grid>
</Window>
